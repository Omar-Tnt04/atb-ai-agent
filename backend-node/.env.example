# ==============================================================================
# ATB AI Agent — Backend Environment Example
# Copy to .env and fill in real values.
# Mode: Hosted Browser Demo | Target: https://atb.tn
# ==============================================================================

# ── 1. Core Server ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
JWT_SECRET=replace_with_secret
JWT_EXPIRES_IN=1d

# ── 2. Hosted Browser Demo ─────────────────────────────────────────────────────
# DEV_MODE is read only by scripts/dev/start*.js — not by the Node server itself.
# Set to "hosted-browser" to skip ai-service-python and internal demo services.
DEV_MODE=hosted-browser

# Exposes GET /dev/open-hosted-demo for launching Chrome from the backend.
ENABLE_DEV_BROWSER_LAUNCHER=true

# ── 3. Chrome / CDP ────────────────────────────────────────────────────────────
CHROME_CDP_PORT=9222
CDP_URL=http://127.0.0.1:9222
TARGET_URL=https://atb.tn

# Full path to Chrome — needed only by ENABLE_DEV_BROWSER_LAUNCHER.
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# CHROME_USER_DATA_DIR=C:/temp/atb-chrome-cdp-profile

# Path to the widget injector extension (relative to project root or absolute).
WIDGET_EXTENSION_PATH=widget-injector-extension

# Allows the CDP Chrome profile to load the HTTP localhost widget inside https://atb.tn.
# Bypasses mixed-content and private-network-access blocks. Dev-only, never production.
ALLOW_LOCAL_WIDGET_HTTP=true

# ── 4. Act-mode Site Index Navigator ───────────────────────────────────────────
# Act mode routing is index-guided. Gemma is used ONLY as a tiny intent parser
# (returns a small JSON: intent/action/target/terms/collections/confidence). It
# never receives the site index and never chooses URLs. The backend scores that
# intent against precomputed indexes built from the Crawlee site index
# (site-context/<domain>/site-index.json) and executes a visible same-tab CDP
# action (navigate / download) over CDP_URL above. No browser-use, no Python,
# no live-LLM browsing. If Ollama is unavailable the parser falls back to generic
# token matching. Regenerate the index with `npm run site:index`.
INTENT_MODEL=gemma4:e4b
INTENT_TIMEOUT_MS=12000
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── 5. Ollama Text Model (Ask mode only) ───────────────────────────────────────
# Text-only chat model used by Ask-mode resource QA. Not used by Act mode.
OLLAMA_TEXT_MODEL=qwen2.5:7b
OLLAMA_TEXT_KEEP_ALIVE=30s

# ── 6. AI Service / Text Model ─────────────────────────────────────────────────
# Python ai-service-python (port 8000). Used for Ask mode intent + resource QA.
# In hosted-browser mode the ai-service is not started by the dev launcher,
# but the Node backend still calls it for Ask mode requests.
AI_SERVICE_URL=http://localhost:8000
MODEL_ROUTING_MODE=text_only

# ── 9. OCR / File Processing ───────────────────────────────────────────────────
OCR_ENABLED=true
OCR_LANGUAGES=eng+fra
# Minimum readable characters before OCR output is considered usable.
OCR_MIN_READABLE_CHARS=8
OCR_REQUEST_TIMEOUT_MS=60000

# ── 10. Ask Mode / Resource Catalog Fallback ───────────────────────────────────
# Laragon resources. REQUIRED for runtime even in hosted-browser mode —
# the resource catalog backs Ask-mode document QA and siteIndex fallback.
RESOURCE_BASE_URL=http://localhost/atb-general-resources
RESOURCE_ROOT_DIR=C:/laragon/www/atb-general-resources
RESOURCE_CATALOG_PATH=C:/laragon/www/atb-general-resources/catalog.json

# Scoring thresholds for resource matching (raw score points, not 0-1).
SEMANTIC_RESOURCE_MIN_SCORE=12
SEMANTIC_RESOURCE_MIN_MARGIN=3

# Trusted-QA confidence gate. A question whose best match scores below MIN_SCORE,
# or beats the runner-up by less than MIN_MARGIN, returns a low-confidence reply.
RESOURCE_QA_MIN_SCORE=30
RESOURCE_QA_MIN_MARGIN=18

# ── 11. Old Internal Demo Services ─────────────────────────────────────────────
# Disabled for hosted-browser demo. Set _ENABLED=true to restore in-process simulation.
INTERNAL_SERVICE_TIMEOUT_MS=5000

PAYMENT_SERVICE_ENABLED=false
PAYMENT_SERVICE_BASE_URL=http://localhost:7101

DOCUMENT_SERVICE_ENABLED=false
DOCUMENT_SERVICE_BASE_URL=http://localhost:7102

ATB_SERVICE_ENABLED=false
ATB_SERVICE_BASE_URL=http://localhost:7106

APPOINTMENT_SERVICE_ENABLED=false
APPOINTMENT_SERVICE_BASE_URL=http://localhost:7104

ACCOUNT_SERVICE_ENABLED=false
ACCOUNT_SERVICE_BASE_URL=http://localhost:7105

# ── 12. Widget / Demo Behavior ─────────────────────────────────────────────────
WIDGET_DEMO_MODE=true

# When true, confirmed write actions (payment, transfer) are simulated locally.
# No real banking action is made. Keep false in hosted-browser demo.
MVP_LOCAL_ACTION_SIMULATION=false

# ── 13. Logging and Debugging ──────────────────────────────────────────────────
# Clean demo console: hides all debug noise, shows only [DEMO] step lines.
DEMO_CONSOLE=true

BACKEND_DEBUG_BOOT=false
DEBUG_AGENT_ROUTING=false
DEV_LAUNCHER_DEBUG=false
LOG_BROWSER_POLLING=false

# Per-request terminal logging: off | summary | verbose.
# verbose needs DEBUG_AGENT_ROUTING=true to show [ROUTE_TRACE] lines.
REQUEST_LOG_MODE=summary
