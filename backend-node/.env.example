PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_secret
JWT_EXPIRES_IN=1d

AI_SERVICE_URL=http://localhost:8000
MODEL_ROUTING_MODE=hybrid
OLLAMA_TEXT_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=qwen3-vl:8b
OLLAMA_TEXT_KEEP_ALIVE=30s
OLLAMA_VISION_KEEP_ALIVE=0s
MAX_CONTEXT_CHARS=4000
MAX_AI_RESPONSE_TOKENS=500
ENABLE_VISION_PDF_ANALYSIS=true
ENABLE_VISION_SUMMARY_CACHE=false
VISION_SUMMARY_CACHE_MAX_ITEMS=20
VISION_SUMMARY_CACHE_TTL_MS=300000
ARCHITECTURE_LOGS_ENABLED=true
LOG_LEVEL=debug
LOG_DIR=../logs
LOG_PRETTY=true

# Laragon demo resource server
RESOURCE_SERVER_BASE_URL=http://localhost/atb-general-resources
RESOURCE_JSON_BASE_URL=http://localhost/atb-general-resources/json
RESOURCE_DOCUMENT_BASE_URL=http://localhost/atb-general-resources/documents

# Development-only standalone widget preview route. Never enable this for
# production banking access unless the route is protected by a real auth layer.
WIDGET_DEMO_MODE=true

OCR_ENABLED=true
OCR_LANGUAGES=eng+fra

# Internal demo services. The normal action path routes through these separate
# local Express services. In production the base URLs point to real ATB internal
# APIs. Timeout applies to all internal service calls.
INTERNAL_SERVICE_TIMEOUT_MS=5000

PAYMENT_SERVICE_ENABLED=true
PAYMENT_SERVICE_BASE_URL=http://localhost:7101

DOCUMENT_SERVICE_ENABLED=true
DOCUMENT_SERVICE_BASE_URL=http://localhost:7102

ATB_SERVICE_ENABLED=true
ATB_SERVICE_BASE_URL=http://localhost:7106

APPOINTMENT_SERVICE_ENABLED=true
APPOINTMENT_SERVICE_BASE_URL=http://localhost:7104

ACCOUNT_SERVICE_ENABLED=true
ACCOUNT_SERVICE_BASE_URL=http://localhost:7105

WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=replace_with_key
