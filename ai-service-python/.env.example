AI_SERVICE_PORT=8000
AI_SERVICE_ENV=development
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:8b
OLLAMA_KEEP_ALIVE=3m
OLLAMA_WARMUP=false
OLLAMA_UNLOAD_AFTER_RESPONSE=false
