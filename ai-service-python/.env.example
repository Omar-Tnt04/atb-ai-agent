AI_SERVICE_PORT=8000
AI_SERVICE_ENV=development
OLLAMA_BASE_URL=http://localhost:11434
MODEL_ROUTING_MODE=hybrid
OLLAMA_TEXT_MODEL=qwen2.5:7b
OLLAMA_TEXT_KEEP_ALIVE=30s
MAX_CONTEXT_CHARS=4000
MAX_AI_RESPONSE_TOKENS=500
OLLAMA_WARMUP=false
OLLAMA_UNLOAD_AFTER_RESPONSE=false
OCR_REQUEST_TIMEOUT_MS=60000
USE_OLLAMA=true
ENABLE_ARCHITECTURE_LOGS=false
DEBUG_RESOURCE_SEARCH=false
LOG_LEVEL=debug
LOG_DIR=../logs
LOG_PRETTY=true
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
