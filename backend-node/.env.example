# ==============================================================================
# ATB AI Agent — Backend environment (example / template)
# Copy to `.env` and fill in real values. `.env` is gitignored.
# Only RESOURCE_ROOT_DIR and RESOURCE_CATALOG_PATH are strictly REQUIRED (the server
# throws on boot without them); everything else has a safe code default.
# Frontend variables (VITE_*) live in widget-agent/.env and web-client/.env — see the
# "Widget / frontend" section note below.
# ==============================================================================

# ── Backend: core server ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Secret for signing demo JWTs. REPLACE with a real random secret in .env.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
# Read only by scripts/dev/start*.js (not the server). "hosted-browser" skips the
# Python ai-service and internal demo services.
DEV_MODE=hosted-browser

# ── Widget / frontend ───────────────────────────────────────────────────────────
# Backend-side widget flags:
WIDGET_DEMO_MODE=true                 # enable the demo widget routes (/api/widget/*)
WIDGET_EXTENSION_PATH=widget-injector-extension
ALLOW_LOCAL_WIDGET_HTTP=true          # dev-only: allow http localhost widget inside https atb.tn
TARGET_URL=https://atb.tn             # target site (drives domain for indexes/site-index)
# Optional explicit URLs (default to localhost):
# BACKEND_URL=http://localhost:5000
# WIDGET_BASE_URL=http://localhost:5000   # used by scripts/ask-test.js
#
# Frontend (set in widget-agent/.env, NOT here):
#   VITE_AGENT_API_URL=http://localhost:5000/api/widget/chat
#   VITE_AGENT_AUTH_TOKEN=            # optional bearer token
# Frontend (web-client/.env): VITE_API_URL=http://localhost:5000

# ── Ollama models ───────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b               # default/act-planner model
DOM_INTENT_MODEL=gemma4:e4b           # DOM browser-agent intent model (falls back to OLLAMA_MODEL)
OLLAMA_TEXT_MODEL=qwen2.5:7b          # text-only chat model (legacy Ask/resource QA)
OLLAMA_TEXT_KEEP_ALIVE=30s

# ── ASK mode (answer synthesis) ─────────────────────────────────────────────────
# qwen3:14b is the primary Ask answer generator when true; deterministic builder is
# the emergency fallback (offline/timeout/empty/invalid-json/guard-reject).
ASK_USE_LLM_SYNTHESIS=true
ASK_SYNTHESIS_MODEL=qwen3:14b
ASK_SYNTHESIS_TIMEOUT_MS=180000
# Testing only: on qwen failure return a diagnostic instead of silent fallback.
ASK_REQUIRE_LLM_SYNTHESIS=false
# Attach debugTrace to ask responses (also per-request via body.debug:true).
ASK_DEBUG_TRACE=false
# Legacy remote Ask provider (used only if semantic+synthesis are off). OpenRouter key
# is a SECRET — leave blank here, set in .env if you use it.
OPENROUTER_API_KEY=
ASK_MODE_PROVIDER=openrouter
ASK_MODE_MODEL=google/gemma-4-31b-it:free
ASK_MODE_FALLBACK_PROVIDER=ollama
ASK_MODE_FALLBACK_MODEL=gemma4:e4b
# ASK_TIMEOUT_MS=30000
# INTENT_MODEL=gemma4:e4b
# INTENT_TIMEOUT_MS=15000

# ── Semantic retrieval (ASK) — bge-m3 embeddings ────────────────────────────────
# Normalize + embed the request ONCE; ASK and ACT reuse the same vector.
REQUEST_PREPARE_EMBEDDING=false
# Semantic-first ASK retrieval over ask-context.json + catalog content.
ASK_USE_SEMANTIC_RETRIEVAL=false
ASK_EMBEDDING_MODEL=bge-m3            # pull once: `ollama pull bge-m3`
# ASK_EMBEDDING_TIMEOUT_MS=120000
ASK_SEMANTIC_TOP_K=4
ASK_SEMANTIC_MIN_SCORE=0.45
# Shared cache base dir for ASK + ACT indexes (NOT under site-context/). Gitignored.
#   ASK: <dir>/<domain>/semantic-index.json   ACT: <dir>/<domain>/site-navigation-index.json
SEMANTIC_INDEX_BASE_DIR=backend-node/.cache/semantic-indexes
# Legacy alias for the ASK index dir (still honored; prefer SEMANTIC_INDEX_BASE_DIR).
ASK_SEMANTIC_INDEX_DIR=backend-node/.cache/semantic-indexes
# Documentation flag: keyword retrieval/navigation stays as emergency fallback (the
# keyword path is always available on semantic failure regardless of this value).
SEMANTIC_FALLBACK_KEYWORD=true

# ── ACT semantic navigation (site-index.json) ───────────────────────────────────
ACT_USE_SEMANTIC_NAVIGATION=false
ACT_EMBEDDING_MODEL=bge-m3
ACT_SEMANTIC_TOP_K=5
ACT_SEMANTIC_MIN_SCORE=0.45

# ── ACT planner / legacy routing ────────────────────────────────────────────────
ACT_PLANNER_ENABLED=true
ACT_PLANNER_MODEL=gemma4:e4b
ACT_PLANNER_MIN_CONFIDENCE=0.55
ACT_PLANNER_TIMEOUT_MS=30000
# Only CDP fast paths (document + page navigation); no browser-use subprocess.
ACT_FAST_PATH_ONLY=true
# Skip Gemma planner and revert to old score-threshold doc routing (debug only).
USE_LEGACY_CANDIDATE_ROUTING=false
MODEL_ROUTING_MODE=text_only

# ── Catalog / Laragon (REQUIRED) ────────────────────────────────────────────────
# The server throws on boot if these two are missing or invalid. Catalog must sit
# inside the root dir as catalog.json.
RESOURCE_ROOT_DIR=C:/laragon/www/atb-general-resources
RESOURCE_CATALOG_PATH=C:/laragon/www/atb-general-resources/catalog.json
RESOURCE_BASE_URL=http://localhost/atb-general-resources
# Optional overrides (default derived from RESOURCE_BASE_URL):
# RESOURCE_SERVER_BASE_URL=http://localhost/atb-general-resources
# RESOURCE_JSON_BASE_URL=http://localhost/atb-general-resources/json
# RESOURCE_DOCUMENT_BASE_URL=http://localhost/atb-general-resources/documents
# Resource match scoring (raw score points, not 0-1):
SEMANTIC_RESOURCE_MIN_SCORE=12
SEMANTIC_RESOURCE_MIN_MARGIN=3
RESOURCE_QA_MIN_SCORE=30
RESOURCE_QA_MIN_MARGIN=18

# ── Browser / CDP ───────────────────────────────────────────────────────────────
CHROME_CDP_PORT=9222
CDP_URL=http://127.0.0.1:9222
USE_CDP=true
HEADLESS=false
ENABLE_DEV_BROWSER_LAUNCHER=true      # exposes GET /dev/open-hosted-demo
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
CHROME_USER_DATA_DIR=C:/temp/atb-browser-agent-profile
# Python interpreter with playwright + browser-use (for full DOM agent):
PYTHON_BIN=C:/path/to/python.exe
PYTHON_AGENT_VERBOSE=false
DOM_MAX_DURATION_MS=180000
DOM_OPEN_FILE_MODE=new_tab            # new_tab | same_tab
DOM_EXTERNAL_NAV_MODE=new_tab         # new_tab | block | same_tab

# ── Python AI service (legacy / fallback) + internal demo services ──────────────
# ai-service-python on :8000. Not started in hosted-browser mode; the Node backend
# still calls it for legacy Ask-mode intent/QA. Safe to leave down — callers degrade.
AI_SERVICE_URL=http://localhost:8000
INTERNAL_SERVICE_TIMEOUT_MS=5000
MVP_LOCAL_ACTION_SIMULATION=false
# In-process demo services (disabled for hosted-browser demo):
PAYMENT_SERVICE_ENABLED=false
PAYMENT_SERVICE_BASE_URL=http://localhost:7101
DOCUMENT_SERVICE_ENABLED=false
DOCUMENT_SERVICE_BASE_URL=http://localhost:7102
ATB_SERVICE_ENABLED=false
ATB_SERVICE_BASE_URL=http://localhost:7106
APPOINTMENT_SERVICE_ENABLED=false
APPOINTMENT_SERVICE_BASE_URL=http://localhost:7104
ACCOUNT_SERVICE_ENABLED=false
ACCOUNT_SERVICE_BASE_URL=http://localhost:7105
# Optional external service bridge (API key is a SECRET — set only in .env):
# EXTERNAL_SERVICE_ENABLED=false
# EXTERNAL_SERVICE_BASE_URL=
# EXTERNAL_SERVICE_API_KEY=
# EXTERNAL_SERVICE_TIMEOUT_MS=8000

# ── OCR / file processing ───────────────────────────────────────────────────────
OCR_ENABLED=true
OCR_LANGUAGES=eng+fra
OCR_MIN_READABLE_CHARS=8
OCR_REQUEST_TIMEOUT_MS=180000
# OCR_IMAGE_MAX_WIDTH=1600
# PDF_MIN_READABLE_CHARS=80
# MAX_MEMORY_TEXT_CHARS=20000

# ── Debug flags ─────────────────────────────────────────────────────────────────
DEMO_CONSOLE=true                     # clean [DEMO] step lines only
REQUEST_LOG_MODE=off                  # off | summary | verbose
BACKEND_DEBUG_BOOT=false
DEBUG_AGENT_ROUTING=false
DEV_LAUNCHER_DEBUG=false
LOG_BROWSER_POLLING=false
# LOG_LEVEL=debug
# LOG_DIR=../logs
# LOG_PRETTY=true
# ATB_DEBUG_LOGS=false
# ENABLE_ARCHITECTURE_LOGS=false
# DEBUG_RESOURCE_SEARCH=false
# DEBUG_RESOURCE_ANSWER=false
